# Package for the sites = `git archive` of a tag: runtime files only.
# Development files, sources and documentation stay in the repository.
/.gitattributes         export-ignore
/.gitignore             export-ignore
/AGENTS.md              export-ignore
/CLAUDE.md              export-ignore
/README.md              export-ignore
/composer.json          export-ignore
/composer.lock          export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/phpcs.xml              export-ignore
/docs                   export-ignore
/tests                  export-ignore
/tools                  export-ignore
# SCSS sources: the built assets/spilno.css ships.
/assets/src             export-ignore
# Translation sources: WordPress reads the .mo.
/languages/*.pot        export-ignore
/languages/*.po         export-ignore
